{
  "name": "are-cse-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-content.mjs",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "extract:are": "python scripts/extract_are_objectives.py sources/are/ARE-5-Guidelines.pdf content/are-objectives.json",
    "fetch:sources": "node scripts/fetch-sources.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
